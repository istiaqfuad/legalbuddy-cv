QDRANT_API_KEY=
QDRANT_URL=
COLLECTION_NAME=

VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-4
# Deep-research agent model (Meta API). Spark 1.3 Standard is the
# default ($1.25/$4.25 per 1M, tool calls verified); Wonder works but
# costs $4/$20. Glimmer becomes a one-line flip once Meta provisions it
# on the key. Free-tier chat stays on muse-spark-open-1026.
META_API_KEY=
AGENT_MODEL=muse-spark-1.3
AGENT_BASE_URL=https://api.meta.ai/v1
# AGENT_API_KEY defaults to META_API_KEY; set only to override.
# Recent-news search (Tavily): curated to Bangladesh newspapers and
# official publishers, topic=news, past month only. Without this key
# the agent simply has no news tool; everything else keeps working.
TAVILY_API_KEY=
# Voyage pacing lives in VoyageDense (request gap + TPM window).
# Defaults = reduced free tier (~3 RPM / 10K TPM).
# Paid tier: VOYAGE_REQUEST_GAP_S=0 and VOYAGE_TOKENS_PER_MIN=<tier limit>
# (optionally raise VOYAGE_MAX_TOKENS_PER_REQUEST too).
VOYAGE_REQUEST_GAP_S=25
VOYAGE_TOKENS_PER_MIN=8000
VOYAGE_MAX_TOKENS_PER_REQUEST=3000

# Retrieval fusion: weighted (dense-heavy, default), rrf, or dbsf.
# DENSE_WEIGHT applies to all queries; DENSE_WEIGHT_BN applies when the
# query carries Bengali-script tokens (same-script BM25 floods otherwise).
FUSION=weighted
DENSE_WEIGHT=0.7
DENSE_WEIGHT_BN=0.85
# Cross-encoder rerank over fusion candidates (jina-reranker-v3.5).
# RERANK_CANDIDATES caps the fusion fetch per retrieval leg.
JINA_RERANK_MODEL=jina-reranker-v3.5
RERANK_CANDIDATES=20

BASETEN_API_KEY=
CHAT_MODEL=


# Postgres — your database connection
DATABASE_URL=
DATABASE_URL_POOLED=

# Neon Managed Better Auth — sign-in for your app
NEON_AUTH_BASE_URL=

# Storage — S3-compatible object storage
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=

# Internal API gate — shared secret between the Next.js server and the
# Python API (x-internal-token header). Set in production; unset locally
# means no gate. Both app processes share the same value.
INTERNAL_API_TOKEN=

# Functions — serverless endpoints
# Deploy a neon function with the 'neon deploy' cli command or deploy a function from one of Neon's sample templates with 'neon bootstrap'

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Auth.js — session signing + callback URL
NEXTAUTH_SECRET=
NEXTAUTH_URL=

JINA_API_KEY=

STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
# Webhook signing secret from `stripe listen` or the Dashboard webhook endpoint.
STRIPE_WEBHOOK_SECRET=
# Price IDs printed by `node web/scripts/stripe-setup.mjs`.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_BUSINESS=
# Comma-separated admin emails allowed to review lawyer verifications.
ADMIN_EMAILS=
# Free-tier cap: assistant answers per user per UTC day on the Lite plan.
LITE_DAILY_MESSAGES=20
# Starter cap: answers per user per UTC day while a Starter subscription is current.
STARTER_DAILY_MESSAGES=100