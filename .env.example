QDRANT_API_KEY=
QDRANT_URL=
COLLECTION_NAME=

VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-4
# Voyage pacing lives in VoyageDense (request gap + TPM window).
# Defaults = reduced free tier (~3 RPM / 10K TPM).
# Paid tier: VOYAGE_REQUEST_GAP_S=0 and VOYAGE_TOKENS_PER_MIN=<tier limit>
# (optionally raise VOYAGE_MAX_TOKENS_PER_REQUEST too).
VOYAGE_REQUEST_GAP_S=25
VOYAGE_TOKENS_PER_MIN=8000
VOYAGE_MAX_TOKENS_PER_REQUEST=3000

# Retrieval fusion: weighted (dense-heavy, default), rrf, or dbsf.
# DENSE_WEIGHT applies to all queries; DENSE_WEIGHT_BN applies when the
# query carries Bengali-script tokens (same-script BM25 floods otherwise).
FUSION=weighted
DENSE_WEIGHT=0.7
DENSE_WEIGHT_BN=0.85

BASETEN_API_KEY=
CHAT_MODEL=


# Postgres — your database connection
DATABASE_URL=
DATABASE_URL_POOLED=

# Neon Managed Better Auth — sign-in for your app
NEON_AUTH_BASE_URL=

# Storage — S3-compatible object storage
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=

# Functions — serverless endpoints
# Deploy a neon function with the 'neon deploy' cli command or deploy a function from one of Neon's sample templates with 'neon bootstrap'

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Auth.js — session signing + callback URL
NEXTAUTH_SECRET=
NEXTAUTH_URL=