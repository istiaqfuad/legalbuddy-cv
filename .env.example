# Copy this file to `.env` and fill in the blanks. Every key below is
# read by the app or its scripts; nothing here is optional unless the
# comment says so. Quote values that contain special characters.

# --- Vector database (Qdrant Cloud) ---
# Get them: https://cloud.qdrant.io → your cluster → API Keys (key) and
# the cluster URL on the overview page (url). COLLECTION_NAME is created
# by the ingestion pipeline if missing.
QDRANT_API_KEY=
QDRANT_URL=
COLLECTION_NAME=

# --- Embeddings (Voyage AI, 1024-dim dense vectors) ---
# Get it: https://dash.voyageai.com → API Keys. Free tier is ~3 RPM,
# which the built-in pacer handles; the paid tier lifts the caps below.
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-4
# Voyage pacing lives in VoyageDense (request gap + TPM window).
# Defaults = reduced free tier (~3 RPM / 10K TPM).
# Paid tier: VOYAGE_REQUEST_GAP_S=0 and VOYAGE_TOKENS_PER_MIN=<tier limit>
# (optionally raise VOYAGE_MAX_TOKENS_PER_REQUEST too).
VOYAGE_REQUEST_GAP_S=25
VOYAGE_TOKENS_PER_MIN=8000
VOYAGE_MAX_TOKENS_PER_REQUEST=3000

# --- Free-tier chat model (Baseten, hackathon key) ---
# Get it: the one-time Baseten link from the hackathon invite (open it
# once, copy the key immediately). Any OpenAI-compatible chat model
# works here: set CHAT_MODEL + CHAT_BASE_URL (+ CHAT_API_KEY, which
# falls back to BASETEN_API_KEY) and restart the api container.
BASETEN_API_KEY=
CHAT_MODEL=meta-models/muse-spark-open-1026
CHAT_BASE_URL=https://inference.baseten.co/v1
# CHAT_API_KEY=

# --- Deep-research agent model (Meta Model API) ---
# Get it: https://dev.meta.ai → your project → API key. Spark 1.3
# Standard is the default ($1.25/$4.25 per 1M, tool calls verified);
# Wonder works but costs $4/$20. Glimmer becomes a one-line AGENT_MODEL
# flip once Meta provisions it on your key. Free-tier chat is unaffected.
META_API_KEY=
AGENT_MODEL=muse-spark-1.3
AGENT_BASE_URL=https://api.meta.ai/v1
# AGENT_API_KEY defaults to META_API_KEY; set only to override.

# --- Recent-news search (Tavily, optional) ---
# Get it: https://app.tavily.com → API Keys (free tier available).
# Curated to Bangladesh newspapers and official publishers, topic=news,
# past month only. Without this key the agent simply has no news tool;
# everything else keeps working.
TAVILY_API_KEY=

# --- Rerank (Jina AI, optional but recommended) ---
# Get it: https://jina.ai → API Keys. Without it retrieval still works;
# results are just fusion-ranked instead of cross-encoder reranked.
JINA_API_KEY=
# Cross-encoder rerank over fusion candidates (jina-reranker-v3.5).
# RERANK_CANDIDATES caps the fusion fetch per retrieval leg.
JINA_RERANK_MODEL=jina-reranker-v3.5
RERANK_CANDIDATES=20

# --- Retrieval fusion (no keys, tuning only) ---
# Retrieval fusion: weighted (dense-heavy, default), rrf, or dbsf.
# DENSE_WEIGHT applies to all queries; DENSE_WEIGHT_BN applies when the
# query carries Bengali-script tokens (same-script BM25 floods otherwise).
FUSION=weighted
DENSE_WEIGHT=0.7
DENSE_WEIGHT_BN=0.85

# --- Postgres (Neon) — your database connection ---
# Get them: https://console.neon.tech → your project → Connect → copy
# the pooled connection string (ends in -pooler) for DATABASE_URL_POOLED
# and the direct one for DATABASE_URL. Keep ?sslmode=require on both.
DATABASE_URL=
DATABASE_URL_POOLED=

# --- Neon Auth — sign-in for your app ---
# Get it: Neon Console → Auth → your Better Auth instance → base URL.
NEON_AUTH_BASE_URL=

# --- Storage — S3-compatible object storage (Neon S3 or AWS) ---
# Get them: Neon Console → Storage → new bucket + access keys, or any
# S3-compatible provider. Endpoint is the storage host (Neon gives you
# one per project); bucket holds lawyer verification files privately.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=

# --- Internal API gate — shared secret between servers ---
# Make one up: `openssl rand -hex 32`. Both app processes share the
# same value via this file. Set in production; unset locally means no
# gate (browsers never see it; the Python API rejects calls without it
# when configured).
INTERNAL_API_TOKEN=

# --- Google sign-in (OAuth client) ---
# Get them: https://console.cloud.google.com → APIs & Services →
# Credentials → Create OAuth client ID (Web application). Add
# <your-app-url>/api/auth/callback/google as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Auth.js — session signing + callback URL ---
# NEXTAUTH_SECRET: make one up with `openssl rand -base64 32`. Never
# reuse it across environments.
# NEXTAUTH_URL: your public app URL in production
# (https://your-app...), http://localhost:3001 for local dev.
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# --- Stripe (test mode keys start with sk_test_/pk_test_) ---
# Get them: https://dashboard.stripe.com → Developers → API Keys
# (use the test-mode pair while building; switch to live at launch).
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
# Webhook signing secret: for local dev run
# `stripe listen --forward-to localhost:3001/api/billing/webhook` and
# paste the printed whsec_... value. In production, create an endpoint
# in Developers → Webhooks pointing at /api/billing/webhook and paste
# its signing secret instead.
STRIPE_WEBHOOK_SECRET=
# Price IDs printed by `node web/scripts/stripe-setup.mjs` (run it once
# per mode; test and live prices differ).
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_BUSINESS=
# Comma-separated admin emails allowed to review lawyer verifications.
ADMIN_EMAILS=
# Free-tier cap: assistant answers per user per UTC day on the Lite plan.
LITE_DAILY_MESSAGES=20
# Starter cap: answers per user per UTC day while a Starter subscription is current.
STARTER_DAILY_MESSAGES=100

# --- Serverless functions (Neon) ---
# Deploy a neon function with the 'neon deploy' cli command or deploy a function from one of Neon's sample templates with 'neon bootstrap'
